{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the MuxSU main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "allow-add-shared-monitor",
    "allow-check-for-update",
    "allow-check-host-switcher-shortcut",
    "allow-complete-onboarding",
    "allow-diagnostics-status",
    "allow-discover-peers",
    "allow-exchange-host-layout",
    "allow-get-dashboard-state",
    "allow-get-host-appearances",
    "allow-get-host-names",
    "allow-get-host-order",
    "allow-get-host-presence",
    "allow-get-input-options",
    "allow-get-settings",
    "allow-install-update",
    "allow-power-cycle-display",
    "allow-prepare-diagnostic-report",
    "allow-probe-peer",
    "allow-redetect-display",
    "allow-refresh-host-presence",
    "allow-refresh-tray",
    "allow-remove-peer",
    "allow-remove-shared-monitor",
    "allow-reset-settings",
    "allow-resync-display-input",
    "allow-save-diagnostic-report",
    "allow-save-settings",
    "allow-select-peer",
    "allow-send-diagnostic-report",
    "allow-set-diagnostics-consent",
    "allow-set-host-appearance",
    "allow-set-host-name",
    "allow-set-host-order",
    "allow-set-input-label",
    "allow-set-local-input",
    "allow-set-locale",
    "allow-set-monitor-identity-link",
    "allow-switch-host",
    "allow-wake-peer",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/OmarHung/MuxSU" },
        { "url": "https://github.com/OmarHung/MuxSU/**" },
        { "url": "https://github.com/HenryHsu/DisplayMux" },
        { "url": "https://github.com/HenryHsu/DisplayMux/**" }
      ]
    }
  ]
}
